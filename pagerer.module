function _pagerer_item_links($variables, $markers, $pages)
{
    $items = array();
    if (!empty($pages)) {
        $i = 0;
        $previous_page = null;
        foreach($pages as $page => $page_data) {
            // if not on first link, then introduce a separator or a breaker between the links
            if (isset($previous_page)) {
                if ($page == $previous_page + 1) {
                    $items[] = array(
                        'class' => array('pager-item'),
                        'data' => $variables['tags']['pager_separator'],
                    );
                } else {
                    $items[] = array(
                        'class' => array('pager-item'),
                        'data' => $variables['tags']['pager_breaker'],
                    );
                }
            }
            // if on first link, but current page is not first, introduce a breaker before the new link
            else if ($page <> 0) {
                $items[] = array(
                    'class' => array('pager-item'),
                    'data' => $variables['tags']['pager_breaker'],
                );
            }
            // sets previous page
            $previous_page = $page;
            $text = $page_data['text'];
            // link to page before the current
            if ($page_data['interval'] < 0) {
                if (isset($page_data['page_pl'])) {
                    $variables['parameters']['page_pl'] = $page_data['page_pl'];
                    $variables['parameters']['page_pr'] = $page_data['page_pr'];
                } else {
                    unset($variables['parameters']['page_pl']);
                    unset($variables['parameters']['page_pr']);
                }
                if (isset($page_data['page_pc'])) {
                    $variables['parameters']['page_pc'] = $page_data['page_pc'];
                } else {
                    unset($variables['parameters']['page_pc']);
                }
                $items[] = array(
                    'class' => array('pager-item'),
                    'data' => theme(
                        'pager_previous',
                        array(
                            'text' => $text,
                            'element' => $variables['element'],
                            'interval' => -$page_data['interval'],
                            'parameters' => $variables['parameters']
                        )
                    ),
                );
            }
            // link to current page
            else if ($page_data['interval'] == 0) {
                if ($variables['drpager']) {
                    $items[] = array(
                       'class' => array('pager-current'),
                       'data' => _pagerer_drpager_widget($variables, $markers),
                    );
                } else {
                    $items[] = array(
                       'class' => array('pager-current'),
                       'data' => $text,
                    );
                }
            }
            // link to page after the current
            else if ($page_data['interval'] > 0){
                if (isset($page_data['page_pl'])) {
                    $variables['parameters']['page_pl'] = $page_data['page_pl'];
                    $variables['parameters']['page_pr'] = $page_data['page_pr'];
                } else {
                    unset($variables['parameters']['page_pl']);
                    unset($variables['parameters']['page_pr']);
                }
                if (isset($page_data['page_pc'])) {
                    $variables['parameters']['page_pc'] = $page_data['page_pc'];
                } else {
                    unset($variables['parameters']['page_pc']);
                }
                $items[] = array(
                    'class' => array('pager-item'),
                    'data' => theme(
                        'pager_next',
                        array(
                            'text' => $text,
                            'element' => $variables['element'],
                            'interval' => $page_data['interval'],
                            'parameters' => $variables['parameters']
                        )
                    ),
                );
            }
            $i++;
        }
        if ($page <> ($markers['pager_max'] - 1)) {
            $items[] = array(
                'class' => array('pager-item'),
                'data' => $variables['tags']['pager_breaker'],
            );
        }
    }
    return $items;
}

function _pagerer_get_neighborhood_pages($variables, $markers)
{
    global $pager_limits;

    // Prepare for generation loop.
    $i = $markers['pager_first'];
    if ($markers['pager_last'] > $markers['pager_max']) {
    // Adjust "center" if at end of query.
        $i = $i + ($markers['pager_max'] - $markers['pager_last']);
        $markers['pager_last'] = $markers['pager_max'];
    }
    if ($i <= 0) {
    // Adjust "center" if at start of query.
        $markers['pager_last'] = $markers['pager_last'] + (1 - $i);
        $i = 1;
    }
    // End of generation loop preparation.

    $pages = array();
    $c = $markers['pager_current'] - 1;
    for (; $i <= $markers['pager_last'] && $i <= $markers['pager_max']; $i++) {
        $offset = $i - $markers['pager_current'];
        $pages[$i - 1]['interval'] = $offset;
        $pages[$i - 1]['text'] = _pagerer_get_page_text($variables, $markers, $c, $offset);
    }
    return $pages;
}

function _pagerer_get_progressive_pages($variables, $markers, $pages, $scale_factor, $ratio, $limit = 0)
{
    global $pager_limits;

    // limit must be positive
    $limit = ($limit < 0) ? -$limit : $limit;

    // avoid endless loop in converging series
    if ($ratio < 1 and $limit == 0) {
        $limit = 2;
    }

    //$pages = array();
    $offset = 0;
    $c = $markers['pager_current'] - 1;
    for ($i = 0; ; $i++) {
        // breaks if limit reached
        if ($limit <> 0 and $i > $limit - 1) {
            break;
        }
        // offset for this cycle
        $offset = intval($scale_factor * pow($ratio, $i));
        // breaks if offset > than total pages
        if ($offset > $markers['pager_max']) {
            break;
        }
        // negative offset
        if ($c - $offset > 0
            and !isset($pages[$c - $offset])
            /*and (!$l_limit or ($l_limit and (($c - $offset) > $l_limit)))*/){
            $pages[$c - $offset]['progressive'] = true;
            $pages[$c - $offset]['interval'] = -$offset;
            $pages[$c - $offset]['text'] = _pagerer_get_page_text($variables, $markers, $c, -$offset, $variables['prog_links']);
        }
        // positive offset
        if ($c + $offset < $markers['pager_max']
            and !isset($pages[$c + $offset])
            /*and (!$r_limit or ($r_limit and (($c + $offset) < $r_limit)))*/) {
            $pages[$c + $offset]['progressive'] = true;
            $pages[$c + $offset]['interval'] = $offset;
            $pages[$c + $offset]['text'] = _pagerer_get_page_text($variables, $markers, $c, $offset, $variables['prog_links']);
        }
    }
    return $pages;
}

function _pagerer_get_page_text($variables, $markers, $current, $offset, $mode = 'absolute')
{
    global $pager_limits;

    $tag = ($offset > 0) ? $variables['tags']['next'] : $variables['tags']['previous'];

    switch ($variables['display']) {
    case 'item_ranges':
        if ($mode == 'absolute') {
            $max = min(($current + $offset + 1) * $pager_limits[$variables['element']], $markers['pager_item_max']);
            $display =   (($current + $offset) * $pager_limits[$variables['element']] + 1)
                       . $variables['tags']['range_separator']
                       . ($max);
        } else {
            $display = t($tag, array ('@num' => abs($offset * $pager_limits[$variables['element']])));
        }
        break;
    case 'items':
        if ($mode == 'absolute') {
            $display = ($current + $offset) * $pager_limits[$variables['element']] + 1;
        } else {
            $display = t($tag, array ('@num' => abs($offset * $pager_limits[$variables['element']])));
        }
        break;
    case 'pages':
    default:
        if ($mode == 'absolute') {
            $display = $current + $offset + 1;
        } else {
            $display = t($tag, array ('@num' => abs($offset)));
        }
        break;
    }
    return $display;
}

