<?php
/**
 * @file
 * Pagerer test case script.
 *
 * A collection of pager themes to enhance Backdrop standard pager.
 *
 */

/**
 * Functional tests for Pagerer.
 */
class PagererTest extends PagerFunctionalWebTestCase {

  protected $pagererAdmin = 'admin/config/user-interface/pagerer';

  /**
   * Get info.
   */
  public static function getInfo() {
    return array(
      'name' => 'Replacement of Backdrop core pager',
      'description' => "Checks that when the basic 'pagerer_standard' theme is set up as a replacement of Backdrop core pager, it still provides the same HTML.",
      'group' => 'Pagerer',
    );
  }

  /**
   * Set up.
   */
  public function setUp() {
    // Enable required modules.
    $modules = array(
      'dblog',
      'pagerer',
      'pagerer_example',
    );
    parent::setUp($modules);

    // Insert 300 log messages.
    for ($i = 0; $i < 300; $i++) {
      watchdog('pager_test', $this->randomString(), NULL, WATCHDOG_DEBUG);
    }

    $this->admin_user = $this->backdropCreateUser(array(
      'access site reports',
      'administer site configuration',
    ));
    $this->backdropLogin($this->admin_user);

    $edit = array(
      'name' => 'core_replace',
    );
    $this->backdropPost($this->pagererAdmin . '/add', $edit, 'Create preset');
    $edit = array(
      'core_override_preset' => 'core_replace',
    );
    $this->backdropPost($this->pagererAdmin, $edit, 'Save configuration');
  }

  /**
   * Tear down.
   */
  public function tearDown() {
    parent::tearDown();
  }

  /**
   * Test that the pagerer_example page loads cleanly.
   *
   * Regression test for two bugs found during the Backdrop port: a query
   * against Drupal 7's 'date_formats' table (which no longer exists in
   * Backdrop - it was migrated to config), and a PHP syntax error from a
   * mistyped logical operator. Both would have been caught immediately by
   * a test that simply loads the page.
   */
  public function testExamplePage() {
    $this->backdropGet('admin/config/user-interface/pagerer/example');
    $this->assertResponse(200);

    // All three example tables should have rendered.
    $this->assertText('First data table:');
    $this->assertText('Second data table:');
    $this->assertText('Third data table:');

    // No PHP errors, warnings, or database exceptions should have leaked
    // into the page output.
    $this->assertNoText('PDOException');
    $this->assertNoText('Warning:');
    $this->assertNoText('Notice:');
    $this->assertNoText('Fatal error');
    $this->assertNoText('Parse error');
  }

}
